<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE6"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/barra_superior"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:background="#8B4513"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/pan_icono" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center_vertical"
                    android:text="Jesus Crust"
                    android:fontFamily="@font/quicksand"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/campanita" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/barra_de_abajo"
                android:layout_width="match_parent"
                android:layout_height="188dp"
                android:background="@drawable/fondolayout"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barra_superior">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand"
                    android:text="Fresh Baked Daily"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand"
                    android:text="Artisan Breads and pastries made with love"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/layout_bg"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/quicksand"
                        android:text="Free delivery on orders $25+"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/camion" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/barra_busqueda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/layout_bg"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barra_de_abajo">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/search"
                    app:tint="@android:color/darker_gray" />
                <EditText
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search for bread, pastries..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/titulo_categorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/quicksand"
                android:text="Categories"
                android:textColor="#8B4513"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barra_busqueda" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_naranja"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="16dp"
                app:backgroundTint="#FF9800"
                app:cornerRadius="35dp"
                app:icon="@drawable/breadicon"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="35dp"
                app:layout_constraintEnd_toStartOf="@+id/button_amarillo"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titulo_categorias" />

            <TextView
                android:id="@+id/text_naranja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/quicksand"
                android:text="Breads"
                android:textColor="#8B4513"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/button_naranja"
                app:layout_constraintStart_toStartOf="@+id/button_naranja"
                app:layout_constraintTop_toBottomOf="@+id/button_naranja" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_amarillo"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="70dp"
                android:layout_height="70dp"
                app:backgroundTint="#FFC107"
                app:cornerRadius="35dp"
                app:icon="@drawable/cookieicon"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="35dp"
                app:layout_constraintEnd_toStartOf="@+id/button_marron"
                app:layout_constraintStart_toEndOf="@+id/button_naranja"
                app:layout_constraintTop_toTopOf="@+id/button_naranja" />

            <TextView
                android:id="@+id/text_amarillo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/quicksand"
                android:text="Pastries"
                android:textColor="#8B4513"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/button_amarillo"
                app:layout_constraintStart_toStartOf="@+id/button_amarillo"
                app:layout_constraintTop_toBottomOf="@+id/button_amarillo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_marron"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="70dp"
                android:layout_height="70dp"
                app:backgroundTint="#795548"
                app:cornerRadius="35dp"
                app:icon="@drawable/cakeicon"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="35dp"
                app:layout_constraintEnd_toStartOf="@+id/button_verde"
                app:layout_constraintStart_toEndOf="@+id/button_amarillo"
                app:layout_constraintTop_toTopOf="@+id/button_naranja" />

            <TextView
                android:id="@+id/text_marron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/quicksand"
                android:text="Cakes"
                android:textColor="#8B4513"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/button_marron"
                app:layout_constraintStart_toStartOf="@+id/button_marron"
                app:layout_constraintTop_toBottomOf="@+id/button_marron" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_verde"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="70dp"
                android:layout_height="70dp"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="35dp"
                app:icon="@drawable/leaficon"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="35dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/button_marron"
                app:layout_constraintTop_toTopOf="@+id/button_naranja" />

            <TextView
                android:id="@+id/text_verde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/quicksand"
                android:text="Organic"
                android:textColor="#8B4513"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/button_verde"
                app:layout_constraintStart_toStartOf="@+id/button_verde"
                app:layout_constraintTop_toBottomOf="@+id/button_verde" />

            <!-- ESTA ES LA LÍNEA CORREGIDA -->
            <TextView
                android:id="@+id/titulo_featured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/quicksand"
                android:text="Featured Today"
                android:textColor="#8B4513"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/button_naranja" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_producto_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titulo_featured">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imagen_producto_1"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/brazodejudas"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/roundedImageView" />

                    <TextView
                        android:id="@+id/nombre_producto_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/quicksand"
                        android:text="Brazo de Judas"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/boton_add_1"
                        app:layout_constraintStart_toEndOf="@+id/imagen_producto_1"
                        app:layout_constraintTop_toTopOf="@+id/imagen_producto_1" />

                    <TextView
                        android:id="@+id/precio_producto_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/quicksand"
                        android:text="$8.99"
                        android:textColor="#8B4513"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@+id/nombre_producto_1"
                        app:layout_constraintTop_toBottomOf="@+id/nombre_producto_1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boton_add_1"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADD"
                        android:textColor="#FF9800"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_producto_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_producto_1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imagen_producto_2"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/croissant"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/roundedImageView" />

                    <TextView
                        android:id="@+id/nombre_producto_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/quicksand"
                        android:text="Pecado Original"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/boton_add_2"
                        app:layout_constraintStart_toEndOf="@+id/imagen_producto_2"
                        app:layout_constraintTop_toTopOf="@+id/imagen_producto_2" />

                    <TextView
                        android:id="@+id/precio_producto_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/quicksand"
                        android:text="$4.50"
                        android:textColor="#8B4513"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@+id/nombre_producto_2"
                        app:layout_constraintTop_toBottomOf="@+id/nombre_producto_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boton_add_2"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADD"
                        android:textColor="#FF9800"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@drawable/bottom_nav_color"
        app:itemTextColor="@drawable/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu"
         />

</androidx.constraintlayout.widget.ConstraintLayout>

